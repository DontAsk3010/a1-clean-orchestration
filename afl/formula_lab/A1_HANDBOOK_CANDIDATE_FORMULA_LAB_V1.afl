// I'AM A1 CLEAN / QHPX
// HANDBOOK-DERIVED CANDIDATE FORMULA LAB V1
// STATUS: RESEARCH CANDIDATES ONLY - NOT FINAL / NOT CANONICAL / NOT LIVE PRODUCTION
// Source-scoped historical mapping:
//   Aux2   -> TRADE_VALUE_1M
//   OpenInt-> NBSS_VALUE_1M (NOT futures OI in validated historical source scope)
//   HAKA=(TRADE_VALUE+NBSS)/2 ; HAKI=(TRADE_VALUE-NBSS)/2
// Flow semantics are valid only when availability and ordinary continuous-stock mechanism are proven.

_SECTION_BEGIN("A1 Handbook Candidate Formula Lab V1");
SetBarsRequired( sbrAll, sbrAll );

// ---------- SOURCE / AVAILABILITY GUARD ----------
TradeValue = Aux2;
NbssValue  = OpenInt;
FlowSourceAvailable = ParamToggle("FLOW source availability PROVEN", "NO|YES", 0 );
OrdinaryContinuousStock = ParamToggle("Ordinary continuous stock mechanism", "NO|YES", 1 );
Tn = TimeNum();
RegularClock = Tn >= 90000 AND Tn < 155000;
FlowEligible = FlowSourceAvailable AND OrdinaryContinuousStock AND RegularClock;

HakaValue = IIf( FlowEligible, ( TradeValue + NbssValue ) / 2, Null );
HakiValue = IIf( FlowEligible, ( TradeValue - NbssValue ) / 2, Null );
BuyEffort  = FlowEligible AND HakaValue > HakiValue;
SellEffort = FlowEligible AND HakiValue > HakaValue;

// Explicit research parameters. These are test dimensions, NOT accepted thresholds.
EffortLB   = Param("F01 effort lookback", 5, 1, 60, 1 );
ProgressLB = Param("F01 progress lookback", 5, 1, 60, 1 );
HighLB     = Param("F03 high lookback", 5, 1, 120, 1 );
RecoveryLB = Param("F05 recovery lookback", 5, 1, 120, 1 );
LowStableBars = Param("F05 low stabilization bars", 3, 1, 60, 1 );
EarlyCheckpointBar = Param("F04 early checkpoint bar", 30, 1, 180, 1 );
LateLiftMinBar = Param("F04 late lift minimum bar", 180, 2, 300, 1 );

// ---------- F01 BUY-STALL ----------
// Handbook meaning: buy effort enters but price/high fails to progress.
F01A_BuyStallBasic = BuyEffort AND H <= Ref( H, -1 ) AND C <= Ref( C, -1 );
PriorHighF01  = Ref( HHV( H, ProgressLB ), -1 );
PriorCloseF01 = Ref( HHV( C, ProgressLB ), -1 );
PriorEffort   = Ref( MA( TradeValue, EffortLB ), -1 );
F01B_BuyStallStaleHighEffort = BuyEffort
    AND H <= PriorHighF01
    AND C <= PriorCloseF01
    AND TradeValue > PriorEffort;

// ---------- F02 SELL-RESILIENCE ----------
// Handbook meaning: sell effort appears but price does not suffer proportional damage.
F02A_SellResilienceBasic = SellEffort AND C >= Ref( C, -1 ) AND L >= Ref( L, -1 );
// Strict canonical-VWAP variant is deliberately not synthesized here.
// It stays unavailable until an exact validated canonical VWAP array is bound into AFL.
F02B_SellResilienceAcceptanceRenewal = 0;
F02B_Availability = 0;

// ---------- F03 FRESH / STALE HIGH ----------
PriorHighF03 = Ref( HHV( H, HighLB ), -1 );
F03A_NewHighEvent = H > PriorHighF03;
HasNewHigh = Cum( F03A_NewHighEvent ) > 0;
F03B_HighAgeBars = IIf( HasNewHigh, BarsSince( F03A_NewHighEvent ), Null );

// ---------- SESSION FRAME FOR F04/F05 ----------
NewCalendarDate = DateNum() != Ref( DateNum(), -1 );
SessionStart = RegularClock AND ( NewCalendarDate OR NOT Ref( RegularClock, -1 ) );
SessionBar = BarsSince( SessionStart );
SessionOpen = ValueWhen( SessionStart, O, 1 );
EarlyMark = RegularClock AND SessionBar == EarlyCheckpointBar - 1;
EarlyClose = ValueWhen( EarlyMark, C, 1 );
EarlyReady = RegularClock AND SessionBar >= EarlyCheckpointBar - 1;
EarlyEstablished = EarlyReady AND EarlyClose > SessionOpen;

// ---------- F04 EARLY STRENGTH VS LATE LIFT ----------
F04A_EarlyStrengthRetained = EarlyReady AND EarlyEstablished AND C >= EarlyClose;
F04B_LateLift = RegularClock
    AND SessionBar >= LateLiftMinBar - 1
    AND NOT EarlyEstablished
    AND C > SessionOpen;

// ---------- F05 RECOVERY RUNNER ----------
PriorWeakness = RegularClock AND Ref( LLV( C, RecoveryLB ), -1 ) < SessionOpen;
SessionLowToHere = LowestSince( SessionStart, L );
SessionNewLow = RegularClock AND L < Ref( SessionLowToHere, -1 );
BarsSinceSessionLow = BarsSince( SessionNewLow );
LowStabilized = RegularClock
    AND BarsSinceSessionLow >= LowStableBars
    AND BarsSinceSessionLow <= SessionBar;
ReclaimSessionOpen = Cross( C, SessionOpen );
RenewedHigh = F03A_NewHighEvent;
F05A_SessionOpenRecovery = PriorWeakness AND LowStabilized AND ReclaimSessionOpen AND RenewedHigh;
// VWAP-specific recovery stays unavailable until canonical VWAP is bound exactly.
F05B_CanonicalVWAPRecovery = 0;
F05B_Availability = 0;

// ---------- F06 PROGRESSIVE H-2 -> H-1 PREPARATION ----------
// TimeFrameGetPrice with NEGATIVE shift reads completed prior sessions only.
H1High  = TimeFrameGetPrice( "H", inDaily, -1 );
H1Low   = TimeFrameGetPrice( "L", inDaily, -1 );
H1Close = TimeFrameGetPrice( "C", inDaily, -1 );
H2High  = TimeFrameGetPrice( "H", inDaily, -2 );
H2Low   = TimeFrameGetPrice( "L", inDaily, -2 );
H2Close = TimeFrameGetPrice( "C", inDaily, -2 );

DTradeValue = TimeFrameCompress( TradeValue, inDaily, compressVolume );
H1TradeValue = TimeFrameExpand( Ref( DTradeValue, -1 ), inDaily, expandFirst );
H2TradeValue = TimeFrameExpand( Ref( DTradeValue, -2 ), inDaily, expandFirst );

F06A_PriceProgress = H1Close > H2Close
    AND H1High > H2High
    AND ( H1High - H1Low ) > ( H2High - H2Low );
F06B_PriceActivityProgress = F06A_PriceProgress AND H1TradeValue > H2TradeValue;

// ---------- RESEARCH EXPLORATION ----------
AnyCandidate = F01A_BuyStallBasic
    OR F01B_BuyStallStaleHighEffort
    OR F02A_SellResilienceBasic
    OR F03A_NewHighEvent
    OR F04A_EarlyStrengthRetained
    OR F04B_LateLift
    OR F05A_SessionOpenRecovery
    OR F06A_PriceProgress
    OR F06B_PriceActivityProgress;

ShowAllRows = ParamToggle("Exploration rows", "CANDIDATES_ONLY|ALL_BARS", 0 );
Filter = IIf( ShowAllRows, 1, AnyCandidate );

AddTextColumn( Name(), "Ticker" );
AddColumn( DateTime(), "DateTime", formatDateTime );
AddColumn( C, "Close", 1.2 );
AddColumn( TradeValue, "TradeValue1m", 1.0 );
AddColumn( NbssValue, "NBSS1m", 1.0 );
AddColumn( HakaValue, "HAKA1m", 1.0 );
AddColumn( HakiValue, "HAKI1m", 1.0 );
AddColumn( FlowEligible, "FlowEligible", 1.0 );
AddColumn( F01A_BuyStallBasic, "F01A BuyStall", 1.0 );
AddColumn( F01B_BuyStallStaleHighEffort, "F01B BuyStall+Stale", 1.0 );
AddColumn( F02A_SellResilienceBasic, "F02A SellResilience", 1.0 );
AddColumn( F02B_Availability, "F02B VWAP Available", 1.0 );
AddColumn( F03A_NewHighEvent, "F03 NewHigh", 1.0 );
AddColumn( F03B_HighAgeBars, "F03 HighAgeBars", 1.0 );
AddColumn( F04A_EarlyStrengthRetained, "F04A EarlyRetained", 1.0 );
AddColumn( F04B_LateLift, "F04B LateLift", 1.0 );
AddColumn( F05A_SessionOpenRecovery, "F05A Recovery", 1.0 );
AddColumn( F05B_Availability, "F05B VWAP Available", 1.0 );
AddColumn( F06A_PriceProgress, "F06A H2-H1 Price", 1.0 );
AddColumn( F06B_PriceActivityProgress, "F06B H2-H1 +Activity", 1.0 );

// No Buy/Sell/Short/Cover/TP/SL is emitted by this lab file.
// Candidate event streams are intended for governed replay/comparison first.
_SECTION_END();
