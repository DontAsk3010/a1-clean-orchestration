// I'AM A1 CLEAN / QHPX
// MG PROFIT-QUALIFIED FORMULA FAMILY V3 - BOOLEAN GATE PARITY LAB
// STATUS: RESEARCH ONLY - NOT CANONICAL / NOT LIVE
//
// This file validates the implementation-independent P01-P06 / N01-N04
// combinator in AFL. It intentionally does NOT synthesize unavailable source
// semantics. Each normalized state must eventually be bound to the governed
// causal feature array with Python<->AFL golden-case parity.

_SECTION_BEGIN("A1 MG Formula Family V3 Gate Lab");

// Normalized proven causal states. ParamToggle is used only as a gate-lab
// harness. Production binding is prohibited until exact feature parity exists.
ACTIVITY_WAKE             = ParamToggle("ACTIVITY_WAKE", "FALSE|TRUE", 0);
RANGE_WAKE                = ParamToggle("RANGE_WAKE", "FALSE|TRUE", 0);
PATH_WAKE                 = ParamToggle("PATH_WAKE", "FALSE|TRUE", 0);
UP_PATH                   = ParamToggle("UP_PATH", "FALSE|TRUE", 0);
PERSISTENCE               = ParamToggle("PERSISTENCE", "FALSE|TRUE", 0);
ACCEPTANCE                = ParamToggle("ACCEPTANCE", "FALSE|TRUE", 0);
VALUE_EXPANSION           = ParamToggle("VALUE_EXPANSION", "FALSE|TRUE", 0);
CONSTRUCTIVE_FLOW         = ParamToggle("CONSTRUCTIVE_FLOW", "FALSE|TRUE", 0);
ANTI_BUY_STALL            = ParamToggle("ANTI_BUY_STALL", "FALSE|TRUE", 0);
FRESH_HIGH                = ParamToggle("FRESH_HIGH", "FALSE|TRUE", 0);
EARLY_STRENGTH_RETAINED   = ParamToggle("EARLY_STRENGTH_RETAINED", "FALSE|TRUE", 0);
RECOVERY_RUNNER           = ParamToggle("RECOVERY_RUNNER", "FALSE|TRUE", 0);
LATE_LIFT                 = ParamToggle("LATE_LIFT", "FALSE|TRUE", 0);
HAD_PULLBACK              = ParamToggle("HAD_PULLBACK", "FALSE|TRUE", 0);
RECLAIM                   = ParamToggle("RECLAIM", "FALSE|TRUE", 0);
RENEWED_HIGH              = ParamToggle("RENEWED_HIGH", "FALSE|TRUE", 0);
STRUCTURE_LOSS            = ParamToggle("STRUCTURE_LOSS", "FALSE|TRUE", 0);
SESSION_SAFE              = ParamToggle("SESSION_SAFE", "FALSE|TRUE", 0);
DATA_COMPLETE             = ParamToggle("DATA_COMPLETE", "FALSE|TRUE", 0);
EXECUTION_READY           = ParamToggle("EXECUTION_READY", "FALSE|TRUE", 0);
PROFIT_ROOM_PASS          = ParamToggle("PROFIT_ROOM_PASS", "FALSE|TRUE", 0);

P01_WAKE_RESPONSE_RETENTION =
    ACTIVITY_WAKE AND PATH_WAKE AND UP_PATH AND PERSISTENCE AND ACCEPTANCE
    AND VALUE_EXPANSION AND ANTI_BUY_STALL AND NOT LATE_LIFT;

P02_RECOVERY_RECLAIM =
    RECOVERY_RUNNER AND ACCEPTANCE AND VALUE_EXPANSION
    AND FRESH_HIGH AND ANTI_BUY_STALL;

P03_COMPRESSION_EXPANSION =
    ACTIVITY_WAKE AND RANGE_WAKE AND PATH_WAKE AND UP_PATH AND ACCEPTANCE
    AND VALUE_EXPANSION AND FRESH_HIGH AND ANTI_BUY_STALL;

P04_PULLBACK_REACCELERATION =
    HAD_PULLBACK AND RECLAIM AND RENEWED_HIGH AND PERSISTENCE
    AND ACCEPTANCE AND VALUE_EXPANSION AND ANTI_BUY_STALL;

P05_FLOW_RESILIENT_CONTINUATION =
    UP_PATH AND PERSISTENCE AND ACCEPTANCE AND VALUE_EXPANSION
    AND CONSTRUCTIVE_FLOW AND ANTI_BUY_STALL AND FRESH_HIGH;

P06_EARLY_STRENGTH_RETAINED =
    PATH_WAKE AND EARLY_STRENGTH_RETAINED AND PERSISTENCE
    AND ACCEPTANCE AND FRESH_HIGH AND ANTI_BUY_STALL AND NOT LATE_LIFT;

N01_BUY_STALL_TRAP       = NOT ANTI_BUY_STALL;
N02_LATE_CHASE_TRAP      = LATE_LIFT;
N03_STRUCTURE_FAILURE    = STRUCTURE_LOSS;
N04_DATA_OR_SESSION_BLOCK= (NOT DATA_COMPLETE) OR (NOT SESSION_SAFE);

BEHAVIOR_PATH_OK =
    P01_WAKE_RESPONSE_RETENTION
    OR P02_RECOVERY_RECLAIM
    OR P03_COMPRESSION_EXPANSION
    OR P04_PULLBACK_REACCELERATION
    OR P05_FLOW_RESILIENT_CONTINUATION
    OR P06_EARLY_STRENGTH_RETAINED;

TRAP_FREE = NOT (
    N01_BUY_STALL_TRAP
    OR N02_LATE_CHASE_TRAP
    OR N03_STRUCTURE_FAILURE
    OR N04_DATA_OR_SESSION_BLOCK
);

MG_BEHAVIOR_CANDIDATE  = BEHAVIOR_PATH_OK AND TRAP_FREE;
MG_EXECUTION_CANDIDATE = MG_BEHAVIOR_CANDIDATE AND EXECUTION_READY;
MG_PROFIT_QUALIFIED    = MG_EXECUTION_CANDIDATE AND PROFIT_ROOM_PASS;

Filter = 1;
AddTextColumn(Name(), "Ticker");
AddColumn(P01_WAKE_RESPONSE_RETENTION, "P01 WakeResponseRetention", 1.0);
AddColumn(P02_RECOVERY_RECLAIM, "P02 RecoveryReclaim", 1.0);
AddColumn(P03_COMPRESSION_EXPANSION, "P03 CompressionExpansion", 1.0);
AddColumn(P04_PULLBACK_REACCELERATION, "P04 PullbackReaccel", 1.0);
AddColumn(P05_FLOW_RESILIENT_CONTINUATION, "P05 FlowContinuation", 1.0);
AddColumn(P06_EARLY_STRENGTH_RETAINED, "P06 EarlyRetained", 1.0);
AddColumn(N01_BUY_STALL_TRAP, "N01 BuyStallTrap", 1.0);
AddColumn(N02_LATE_CHASE_TRAP, "N02 LateChaseTrap", 1.0);
AddColumn(N03_STRUCTURE_FAILURE, "N03 StructureFailure", 1.0);
AddColumn(N04_DATA_OR_SESSION_BLOCK, "N04 DataSessionBlock", 1.0);
AddColumn(MG_BEHAVIOR_CANDIDATE, "MG Behavior Candidate", 1.0);
AddColumn(MG_EXECUTION_CANDIDATE, "MG Execution Candidate", 1.0);
AddColumn(MG_PROFIT_QUALIFIED, "MG Profit Qualified", 1.0);

// This lab emits no Buy/Sell/Short/Cover orders.
Buy = Sell = Short = Cover = 0;

_SECTION_END();
