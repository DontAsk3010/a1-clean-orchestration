{
  "schema": "A1_SEMANTIC_ENRICHMENT_BACKFILL_CONTRACT_V1",
  "status": "RESEARCH_ONLY_NOT_CANONICAL",
  "owner_lock_date": "2026-09-18",
  "purpose": "Add richer manual-style semantic journey representation to the governed Formula Research engine without destructively rewriting already-PASS historical artifacts.",
  "default_strategy": "FULL_CORPUS_APPEND_ONLY_ENRICHMENT_FROM_DURABLE_TF1M_EVIDENCE",
  "old_artifacts_immutable": true,
  "destructive_rewrite_forbidden": true,
  "raw_reextraction_default": false,
  "raw_reread_allowed_only_when": [
    "required semantic evidence is absent from retained durable evidence",
    "required lane was not retained",
    "source-gap or exact causal timing cannot be established from retained artifacts",
    "provenance cannot be reconstructed faithfully",
    "integrity or regression audit proves a real defect"
  ],
  "raw_reread_scope_rule": "NARROWEST_REQUIRED_SOURCE_OR_LANE; whole-corpus RAW rebuild only if the missing evidence is corpus-wide and unrecoverable otherwise",
  "manual_reference_role": "READ_ONLY_GOLDEN_AND_CONCORDANCE_REFERENCE_NOT_HIDDEN_LABEL",
  "manual_absence_means": "NOT_MANUALLY_READ",
  "required_enrichment_capabilities": [
    "FORMATION_SEQUENCE",
    "EVENT_JOURNEY",
    "NO_FORCED_EVENT",
    "OPEN_RIGHT_CENSORED",
    "CROSS_DATE_OPEN_CARRY",
    "SOURCE_GAP_TIMING_UNCERTAINTY",
    "FIRST_OBSERVED_TIME",
    "FIRST_CAUSAL_DETECTABLE_TIME",
    "CHANGE_POINT_TIME",
    "CONFIRM_NON_CONFIRM_TIME",
    "WEAKENING_TIME",
    "FAIL_INVALIDATION_TIME",
    "RECOVERY_TIME",
    "RECOVERY_DURABILITY",
    "FAILED_RECOVERY",
    "REBASE_TRANSFORMATION",
    "EVENT_END_OR_LAST_RELEVANT_TIME",
    "CAUSAL_VIEW_SEPARATE_FROM_HINDSIGHT_VIEW",
    "EXPLICIT_UNKNOWN_UNPROVEN_AVAILABILITY"
  ],
  "lineage_key_minimum": [
    "source_identity",
    "source_version_or_digest_where_available",
    "ticker",
    "trading_date",
    "source_row_or_durable_row_identity",
    "timestamp_or_time_range",
    "parent_schema",
    "parent_artifact_or_digest",
    "enrichment_schema_version"
  ],
  "join_policy": {
    "preferred_exact_join": [
      "source_identity_or_bound_source_digest",
      "ticker",
      "trading_date",
      "exact_timestamp_or_exact_source_row_identity"
    ],
    "event_level_join_requires": [
      "same source lineage",
      "same ticker",
      "same trading date or explicit cross_date_carry_parent",
      "source-linked start/end or causal time range"
    ],
    "cross_date_carry_rule": "link as parent-child event lineage across trading dates; never coerce into same-day rows",
    "never_join_on_ticker_and_clock_alone": true,
    "never_overwrite_parent_record": true,
    "unmatched_or_conflicting_record_action": "QUARANTINE_AS_UNRESOLVED_DO_NOT_MERGE"
  },
  "compatibility_gates_before_merge": [
    "source identity/version/digest compatibility",
    "ticker and trading-date identity",
    "timestamp/session/calendar alignment",
    "overlap OHLCV/source-row equality where both sides carry those facts",
    "lane semantic and availability compatibility",
    "causal known-at timing compatibility",
    "no future-data leakage",
    "no duplicate or orphan lineage"
  ],
  "merge_statuses": [
    "EXACT_MATCH",
    "COMPATIBLE_ENRICHMENT",
    "PARTIAL_MATCH_NEEDS_REVIEW",
    "SOURCE_OR_TIMING_CONFLICT",
    "UNMATCHED",
    "NOT_APPLICABLE"
  ],
  "coverage_policy": {
    "manual_examples_only": false,
    "all_applicable_governed_non_oos_ticker_days": true,
    "no_winner_only_filter": true,
    "no_forced_event": true,
    "reserved_oos_untouched": true
  },
  "reconciliation_requirements": [
    "exact input coverage",
    "exact applicable output coverage",
    "no duplicate lineage",
    "no orphan lineage",
    "explicit OLD_BASELINE_STATE versus NEW_ENRICHED_STATE",
    "timestamps and uncertainty preserved",
    "manual overlap concordance reported separately from non-overlap",
    "every enriched record has explicit merge status",
    "all conflicts and unmatched records remain visible and are never silently coerced"
  ],
  "promotion_gates": [
    "manual-machine concordance on overlap",
    "deterministic reproducibility",
    "causal timestamp integrity",
    "no future leakage",
    "full applicable corpus backfill",
    "failure/no-event/censored preservation",
    "near-twin discrimination",
    "cross-period robustness",
    "ablation before formula influence"
  ],
  "historical_pass_layers_not_to_rerun_by_default": [
    "V2.1_CENSUS",
    "V2.2_MULTILAYER_EPISODE_MINER",
    "V2.3_MOTIF_REGISTRY",
    "V2.4_GLOBAL_MOTIF_MERGE",
    "V2.5_CAUSAL_DIVERGENCE_ATLAS"
  ],
  "downstream_versioning_rule": "If enrichment materially adds discriminative information, create a new downstream research version over the enriched layer (for example V3.x). Do not relabel or overwrite V2.x outputs and do not pretend V2.x already contained the new semantics.",
  "baseline_comparison_required": true
}
