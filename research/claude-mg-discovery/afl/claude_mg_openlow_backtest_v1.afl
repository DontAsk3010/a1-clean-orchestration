_SECTION_BEGIN("MG OPEN=LOW BACKTEST V1 - RESEARCH ONLY");
//=============================================================================
//  A1 CLEAN / QHPX - Telegram A - MULAI GENIT (MG)
//  Backtest Open=Low: tiap sinyal dibeli Rp5.000.000, lot penuh.
//
//  INI YANG MENJAWAB "ENTRY 5 JUTA DAPAT P/L BERAPA".
//  Screener tidak bisa menjawabnya karena saat sinyal muncul harga belum
//  bergerak. Backtest menjawabnya karena harga sesudahnya sudah ada.
//
//  Laporan Backtest AmiBroker akan memuat, per transaksi:
//      Symbol | Trade | Date | Price(entry) | Ex.date | Ex.Price | % chg |
//      Profit | MAE | MFE
//  Itu persis SAHAM | ENTRY | EXIT | PROFIT/LOSS | MAX PROFIT.
//
//  STATUS: RESEARCH_ONLY. Tidak ada promosi kanonik dari lane riset ini.
//=============================================================================

//--- Modal dan lot ---------------------------------------------------------
Modal = Param("Modal per sinyal (Rp)", 5000000, 1000000, 100000000, 1000000);

SetOption("InitialEquity",   5000000000 );  // besar, supaya tidak ada sinyal
SetOption("MaxOpenPositions", 500 );        // yang ditolak karena kehabisan uang
SetOption("AllowSameBarExit", True );
SetOption("ActivateStopsImmediately", True );
SetOption("CommissionMode",  2 );           // 2 = persen dari nilai transaksi
SetOption("CommissionAmount", Param("Fee beli+jual %", 0.0, 0, 1, 0.01) );

SetPositionSize( Modal, spsValue );
RoundLotSize  = 100;                        // 1 lot IDX = 100 lembar
TickSize      = 0;                          // dibiarkan bebas, IDX multi fraksi

// Masuk dan keluar di bar yang sama dengan sinyalnya, tanpa penundaan.
// Ini proxy HAKA. Tanpa data L1 ask/queue ini BUKAN fill HAKA sebenarnya.
SetTradeDelays(0, 0, 0, 0);

//--- Parameter penyaring, sama persis dengan screener ----------------------
MinPrice     = Param("[UKUR] Lantai harga (Rp)",        100,   1, 5000, 1);
MinChg       = Param("[SETEL] Naik minimal hari ini %", 3.5,   0,   25, 0.1);
MaxChg       = Param("[SETEL] Naik maksimal hari ini %",12.0,   1,   35, 0.5);
MinValueRp   = Param("[SETEL] Nilai transaksi min (Rp)", 1e9, 1e7, 5e10, 1e7);
ARAMargin    = Param("[UKUR] Jarak minimal ke ARA %",    2.0,   0,   10, 0.5);
MinPrevRange = Param("[SETEL] Range kemarin minimal %",  4.0,   0,   30, 0.5);

//--- Referensi harian ------------------------------------------------------
DayO  = TimeFrameGetPrice("O", inDaily,  0);
DayL  = TimeFrameGetPrice("L", inDaily,  0);
PrevC = TimeFrameGetPrice("C", inDaily, -1);
PrevH = TimeFrameGetPrice("H", inDaily, -1);
PrevL = TimeFrameGetPrice("L", inDaily, -1);

Chg        = IIf(PrevC > 0, (C / PrevC - 1) * 100, 0);
PrevRange  = IIf(PrevC > 0, (PrevH - PrevL) / PrevC * 100, 0);
ValueToday = TimeFrameGetPrice("V", inDaily, 0) * C;

ARALimit  = IIf(PrevC < 200, 35, IIf(PrevC < 5000, 25, 20));
ARAPrice  = PrevC * (1 + ARALimit / 100);
RoomToARA = IIf(C > 0, (ARAPrice / C - 1) * 100, 0);

OpenIsLow = DayL >= DayO AND DayO > 0;

Screened = OpenIsLow
       AND C >= MinPrice
       AND ValueToday >= MinValueRp
       AND RoomToARA >= ARAMargin
       AND Chg >= MinChg AND Chg <= MaxChg
       AND PrevRange >= MinPrevRange;

//--- Tangga target ---------------------------------------------------------
function IdxTick(px)
{
    return IIf(px < 200, 1, IIf(px < 500, 2, IIf(px < 2000, 5,
           IIf(px < 5000, 10, 25))));
}
function RoundUpTick(px)
{
    t = IdxTick(px);
    return ceil(px / t) * t;
}

TP1pct = IIf(Chg <  3.5,  3.5, IIf(Chg <  5.0,  5.0, IIf(Chg <  5.7,  5.7,
         IIf(Chg <  7.0,  7.0, IIf(Chg < 10.0, 10.0, IIf(Chg < 12.0, 12.0,
         IIf(Chg < 15.0, 15.0, IIf(Chg < 20.0, 20.0, IIf(Chg < 25.0, 25.0, 1e9)))))))));

TP1 = RoundUpTick(PrevC * (1 + TP1pct / 100));
TP1 = IIf(TP1 > ARAPrice, 1e9, TP1);   // target di atas ARA mustahil tercapai

//--- Sinyal ----------------------------------------------------------------
// Satu posisi per ticker per hari: hanya bar PERTAMA yang lolos.
NewDay    = Day() != Ref(Day(), -1);
FirstPass = Screened AND (NewDay OR NOT Ref(Screened, -1));

Buy      = FirstPass;
BuyPrice = C;                          // proxy HAKA di bar sinyal

// Keluar: target tersentuh, atau tutup di harga close hari itu.
// Aturan ini sengaja polos supaya hasilnya tidak dipercantik exit yang pintar.
ExitTime = Param("Jam tutup posisi (HHMMSS)", 155500, 90000, 160000, 100);
EODBar   = IIf(Status("barinday") == 0, 0, TimeNum() >= ExitTime);
// Di database harian, EODBar dipaksa true: satu bar = satu hari.
IsDaily  = Interval() >= inDaily;
EODBar   = IIf(IsDaily, True, EODBar);

HitTP1   = H >= TP1;
Sell     = HitTP1 OR EODBar;
SellPrice = IIf(HitTP1, Min(TP1, H), C);

Buy  = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);

//--- Kolom tambahan di daftar transaksi ------------------------------------
// Muncul di tab Trades laporan Backtest.
SetCustomBacktestProc("");
AddColumn(TP1, "TP-1", 1.0);
AddColumn(Chg, "CHG% saat entry", 1.2);
Filter = Buy;

//=============================================================================
//  CARA PAKAI
//  1. Simpan di Formulas\Custom.
//  2. Analysis > pilih formula ini > Settings:
//       - Periods: pilih rentang tanggalnya, misal 1-31 Desember 2024
//       - Positions: Long only
//       - Report: centang "Show MAE/MFE"  <- ini kolom MAX PROFIT Anda
//  3. Tekan BACKTEST (bukan Explore, bukan Scan).
//  4. Buka tab Report > Trades.
//     Kolomnya: Symbol | Trade | Date | Price | Ex.date | Ex.Price | % chg |
//               Profit | MAE | MFE
//     Price = ENTRY, Ex.Price = EXIT, Profit = PROFIT/LOSS, MFE = MAX PROFIT.
//  5. Kanan-klik daftar Trades > Export ke CSV kalau mau diolah lagi.
//
//  CATATAN UKURAN POSISI
//  Rp5 juta tidak membeli jumlah lot yang sama di tiap harga. RoundLotSize=100
//  membuat AmiBroker membulatkan ke bawah ke lot penuh, sama seperti kenyataan:
//     harga   100 -> 500 lot, terpakai Rp5.000.000
//     harga 9.750 ->   5 lot, terpakai Rp4.875.000 (sisa Rp125.000 menganggur)
//  MaxOpenPositions 500 dan InitialEquity 5 miliar dipasang besar supaya tiap
//  sinyal benar-benar dibeli dan tidak ada yang dilewati karena kehabisan uang.
//  Itu sesuai permintaan: tiap sinyal beli Rp5 juta, bukan bergantian.
//
//  ANGKA PEMBANDING YANG SUDAH DIUKUR DI LUAR AMIBROKER
//  Desember 2024, Open=Low + syarat naik 7%, TANPA filter lantai harga dan
//  anti-ARA: 166 sinyal, 58 untung / 66 rugi / 42 impas, modal terpakai
//  Rp825.274.000, hasil bersih MINUS Rp17.678.396 (-2,14%).
//  Kalau backtest Anda memberi angka yang jauh lebih bagus dari itu, periksa
//  dulu: biasanya karena TradeDelays, atau karena filter Anda lebih ketat.
//=============================================================================
_SECTION_END();
