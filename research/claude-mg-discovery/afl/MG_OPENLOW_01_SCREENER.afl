//=============================================================================
//  MG_OPENLOW_01_SCREENER
//  >>> TEKAN TOMBOL: EXPLORE  <<<
//
//  Output: CODE | PRICE | CHG% | TP-1 | TP-2 | LOT | ENTRY Rp | POTENSI
//
//  Kalau yang keluar cuma Symbol/Trade/Date/Close, berarti Anda menekan SCAN.
//  Scan mengabaikan semua AddColumn. Tekan EXPLORE.
//
//  File ini TIDAK punya Buy/Sell dan TIDAK punya SetCustomBacktestProc.
//  Jangan tambahkan keduanya: Buy/Sell membuat Scan tampak benar, dan
//  SetCustomBacktestProc memanggil kode report formula lain (penyebab Error 61).
//
//  STATUS: RESEARCH_ONLY.
//=============================================================================
_SECTION_BEGIN("MG OPENLOW 01 SCREENER");

SetOption("NoDefaultColumns", True);

//--- Parameter -------------------------------------------------------------
//  [UKUR] = berasal dari pengukuran Desember 2024. [SETEL] = konvensi, bebas digeser.
MinPrice     = Param("[UKUR] Lantai harga (Rp)",        100,   1, 5000, 1);
MinChg       = Param("[SETEL] Naik minimal hari ini %", 3.5,   0,   25, 0.1);
MaxChg       = Param("[SETEL] Naik maksimal hari ini %",12.0,   1,   35, 0.5);
MinValueRp   = Param("[SETEL] Nilai transaksi min (Rp)", 1e9, 1e7, 5e10, 1e7);
ARAMargin    = Param("[UKUR] Jarak minimal ke ARA %",    2.0,   0,   10, 0.5);
MinPrevRange = Param("[SETEL] Range kemarin minimal %",  4.0,   0,   30, 0.5);
Modal        = Param("[SETEL] Modal per sinyal (Rp)", 5000000, 1000000, 100000000, 1000000);

//--- Referensi harian, aman dipakai intraday -------------------------------
//  shift 0  = hari ini yang SEDANG berjalan, hanya memakai bar sampai sekarang
//  shift -1 = hari bursa sebelumnya
//  Tidak ada bar masa depan yang dibaca.
DayO  = TimeFrameGetPrice("O", inDaily,  0);
DayL  = TimeFrameGetPrice("L", inDaily,  0);
PrevC = TimeFrameGetPrice("C", inDaily, -1);
PrevH = TimeFrameGetPrice("H", inDaily, -1);
PrevL = TimeFrameGetPrice("L", inDaily, -1);

Chg        = IIf(PrevC > 0, (C / PrevC - 1) * 100, 0);
PrevRange  = IIf(PrevC > 0, (PrevH - PrevL) / PrevC * 100, 0);
ValueToday = TimeFrameGetPrice("V", inDaily, 0) * C;

//--- Batas ARA IDX: 50-200 = 35%, 200-5000 = 25%, di atas 5000 = 20% -------
ARALimit  = IIf(PrevC < 200, 35, IIf(PrevC < 5000, 25, 20));
ARAPrice  = PrevC * (1 + ARALimit / 100);
RoomToARA = IIf(C > 0, (ARAPrice / C - 1) * 100, 0);

//--- SCOUT: harga belum pernah turun di bawah open hari ini -----------------
//  Bentuk kausal, bisa dibaca live tiap slot. "Open == Low final" itu label
//  hindsight dan tidak dipakai.
OpenIsLow = DayL >= DayO AND DayO > 0;

Screened = OpenIsLow
       AND C >= MinPrice
       AND ValueToday >= MinValueRp
       AND RoomToARA >= ARAMargin
       AND Chg >= MinChg AND Chg <= MaxChg
       AND PrevRange >= MinPrevRange;

//--- Fraksi harga IDX ------------------------------------------------------
function IdxTick(px)
{
    return IIf(px < 200, 1, IIf(px < 500, 2, IIf(px < 2000, 5,
           IIf(px < 5000, 10, 25))));
}
function RoundUpTick(px)
{
    t = IdxTick(px);
    return ceil(px / t) * t;
}

//--- Tangga target: 3,5 - 5 - 5,7 - 7 - 10 - 12 - 15 - 20 - 25 -------------
TP1pct = IIf(Chg <  3.5,  3.5, IIf(Chg <  5.0,  5.0, IIf(Chg <  5.7,  5.7,
         IIf(Chg <  7.0,  7.0, IIf(Chg < 10.0, 10.0, IIf(Chg < 12.0, 12.0,
         IIf(Chg < 15.0, 15.0, IIf(Chg < 20.0, 20.0, IIf(Chg < 25.0, 25.0, Null)))))))));

TP2pct = IIf(Chg <  3.5,  5.0, IIf(Chg <  5.0,  5.7, IIf(Chg <  5.7,  7.0,
         IIf(Chg <  7.0, 10.0, IIf(Chg < 10.0, 12.0, IIf(Chg < 12.0, 15.0,
         IIf(Chg < 15.0, 20.0, IIf(Chg < 20.0, 25.0, Null))))))));

TP1 = RoundUpTick(PrevC * (1 + TP1pct / 100));
TP2 = RoundUpTick(PrevC * (1 + TP2pct / 100));
TP1 = IIf(TP1 > ARAPrice, Null, TP1);
TP2 = IIf(TP2 > ARAPrice, Null, TP2);

//--- Ukuran posisi, lot penuh 100 lembar -----------------------------------
Lot      = floor(Modal / (C * 100));
Lembar   = Lot * 100;
Terpakai = Lembar * C;

//=============================================================================
//  EXPLORATION
//=============================================================================
Filter = Screened;

AddTextColumn(Name(), "CODE",  1.0);
AddColumn(C,          "PRICE", 1.0);
AddColumn(Chg,        "CHG%",  1.2);
AddColumn(TP1,        "TP-1",  1.0);
AddColumn(TP2,        "TP-2",  1.0);
AddColumn(Lot,        "LOT",      1.0);
AddColumn(Terpakai,   "ENTRY Rp", 1.0);

//  POTENSI, bukan hasil. Rupiah yang didapat KALAU target tersentuh.
//  Screener berjalan saat sinyal terbit, ketika harga belum bergerak, jadi
//  untung rugi belum ada. Untuk P/L sungguhan pakai MG_OPENLOW_02_BACKTEST.
AddColumn(Lembar * (TP1 - C), "POTENSI TP-1", 1.0);
AddColumn(Lembar * (TP2 - C), "POTENSI TP-2", 1.0);

AddColumn(RoomToARA,  "KE ARA%",    1.2);
AddColumn(ValueToday, "VALUE",      1.0);
AddColumn(PrevRange,  "RANGE KMR%", 1.2);

//=============================================================================
//  CARA PAKAI
//  1. Analysis > pilih formula ini > Apply to: All symbols (atau watchlist IDX)
//  2. Range: "1 recent bar" untuk screening live
//  3. Tekan EXPLORE
//  4. Database intraday 5 menit: tiap bar = satu slot publikasi mulai 09:00.
//     Saham yang masih lolos di slot berikutnya muncul lagi; kalau tidak lolos
//     dia hilang dan bisa muncul lagi nanti. Itu perilaku yang benar.
//
//  PERINGATAN JUJUR
//  Filter di atas memotong kerusakan yang terukur, bukan bukti untung.
//  Yang sudah direplay penuh baru versi TANPA filter, hasilnya MINUS
//  Rp17.678.396 dari 166 sinyal di Desember 2024. Kombinasi dengan filter ini
//  belum direplay utuh.
//=============================================================================
_SECTION_END();
